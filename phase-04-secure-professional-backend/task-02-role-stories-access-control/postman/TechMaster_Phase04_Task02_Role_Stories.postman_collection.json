    },
    {
      "name": "01. Mandatory Access Matrix Tests (8 Required Tests)",
      "item": [
        {
          "name": "Test 1 - No token accesses admin report (Expected: 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/reports/revenue-summary",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "revenue-summary"]
            }
          }
        },
        {
          "name": "Test 2 - Student token accesses admin report (Expected: 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/reports/revenue-summary",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "revenue-summary"]
            }
          }
        },
        {
          "name": "Test 3 - Instructor sees own tracks (Expected: 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Instructor tracks returned\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructor_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/instructor/my-tracks",
              "host": ["{{base_url}}"],
              "path": ["api", "instructor", "my-tracks"]
            }
          }
        },
        {
          "name": "Test 4 - Instructor sees another instructor track details (Expected: 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Cross-instructor guard triggered\", function () {",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructor_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/tracks/3/students",
              "host": ["{{base_url}}"],
              "path": ["api", "tracks", "3", "students"]
            }
          }
        },
        {
          "name": "Test 5 - Student sees own enrollments (Expected: 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Returns list of student's own enrollments\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/student/my-enrollments",
              "host": ["{{base_url}}"],
              "path": ["api", "student", "my-enrollments"]
            }
          }
        },
        {
          "name": "Test 6 - Student tries another student profile (Expected: 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Cross-student profile isolation enforced\", function () {",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/students/2",
              "host": ["{{base_url}}"],
              "path": ["api", "students", "2"]
            }
          }
        },
        {
          "name": "Test 7 - Admin updates payment status (Expected: 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Admin successfully updated payment status\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.paymentStatus).to.eql(\"Completed\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\",\n  \"notes\": \"Payment verified by Finance Admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/payments/1/status",
              "host": ["{{base_url}}"],
              "path": ["api", "payments", "1", "status"]
            }
          }
        },
        {
          "name": "Test 8 - Student updates payment status (Expected: 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\",\n  \"notes\": \"Student trying to approve their own payment\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/payments/1/status",
              "host": ["{{base_url}}"],
              "path": ["api", "payments", "1", "status"]
            }
          }
        }
      ]
    }
