  "info": {
    "_postman_id": "b1c2d3e4-f5a6-47b8-8c9d-0e1f2a3b4c5d",
    "name": "TechMaster Phase 04 - Task 02: Role Stories & Access Control",
    "description": "Comprehensive Postman test suite validating the 8 mandatory Task 02 authorization scenarios, role stories (Admin, Instructor, Student), cross-user data isolation, and boundary enforcement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00. Auth Setup (Get Tokens)",
      "item": [
        {
          "name": "00a - Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Admin login succeeded\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"admin_token\", jsonData.data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@techmaster.com\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
