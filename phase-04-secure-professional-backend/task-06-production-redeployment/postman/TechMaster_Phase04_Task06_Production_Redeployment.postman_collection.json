	"item": [
		{
			"name": "01 - Live System Health & Swagger Verification",
			"item": [
				{
					"name": "Live Health Check (Remote Database Connectivity)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Health Status is Healthy / Connected\", function () {",
									"    pm.expect(jsonData.status).to.eql(\"Healthy\");",
									"    pm.expect(jsonData.databaseConnected).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"health"
							]
						}
					},
					"response": []
				},
				{
					"name": "Live Swagger Documentation Endpoint",
