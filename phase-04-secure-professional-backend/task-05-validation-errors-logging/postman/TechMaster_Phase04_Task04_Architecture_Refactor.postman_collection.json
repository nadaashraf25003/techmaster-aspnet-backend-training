    {
      "name": "07. Validation Standard - 400 Bad Request Envelope with Error List",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"code\": \"\",\n  \"price\": -500,\n  \"capacity\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/tracks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tracks"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Standard failure ApiResponse envelope with errors array', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.errors).to.be.an('array').that.is.not.empty;",
              "    pm.expect(jsonData.statusCode).to.eql(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "08. Service & DTO Layer - Paginated Tracks Result",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tracks?pageNumber=1&pageSize=5",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tracks"],
          "query": [
            { "key": "pageNumber", "value": "1" },
            { "key": "pageSize", "value": "5" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('PagedResult pagination shape is verified', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property('items');",
              "    pm.expect(jsonData.data).to.have.property('totalCount');",
              "    pm.expect(jsonData.data).to.have.property('pageNumber');",
              "    pm.expect(jsonData.data).to.have.property('pageSize');",
              "    pm.expect(jsonData.data).to.have.property('totalPages');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
