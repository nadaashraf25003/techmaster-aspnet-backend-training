  "item": [
    {
      "name": "01. Positive Auth Flows",
      "item": [
        {
          "name": "01 - Register New Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Registration returns success envelope\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.email).to.eql(\"mohamed.ayman@example.com\");",
                  "    pm.expect(jsonData.data.role).to.eql(\"Student\");",
                  "    pm.expect(jsonData.data.linkedStudentId).to.be.a(\"number\");",
                  "});",
                  "if (jsonData.data && jsonData.data.userId) {",
                  "    pm.collectionVariables.set(\"new_user_id\", jsonData.data.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Mohamed Ayman\",\n  \"email\": \"mohamed.ayman@example.com\",\n  \"password\": \"Password@123456\",\n  \"confirmPassword\": \"Password@123456\",\n  \"role\": \"Student\",\n  \"phoneNumber\": \"+201012345678\",\n  \"address\": \"Nasr City, Cairo\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "02 - Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Admin login returns valid JWT token and role\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.role).to.eql(\"Admin\");",
                  "    pm.expect(jsonData.data.accessToken).to.be.a(\"string\");",
                  "});",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set(\"admin_token\", jsonData.data.accessToken);",
                  "    pm.collectionVariables.set(\"admin_refresh_token\", jsonData.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
